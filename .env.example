# Local development. Match these credentials with compose.yaml.
DATABASE_URL=postgresql+psycopg://selamate:selamate_dev@localhost:5432/selamate
# simulation works without PostgreSQL; database uses migrated/seeded tables.
DATA_SOURCE=simulation
POSTGRES_USER=selamate
POSTGRES_PASSWORD=selamate_dev
POSTGRES_DB=selamate

# Existing frontend uses the /api proxy. For a separate frontend origin, use a JSON array.
CORS_ORIGINS=[]
FATIGUE_MAX_UPLOAD_BYTES=104857600
FATIGUE_MAX_VIDEO_SECONDS=300
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_SECONDS=604800
