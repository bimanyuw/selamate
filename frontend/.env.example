# Existing Vite proxy targets the local backend on port 3001.
VITE_API_BASE_URL=/api
BACKEND_PROXY_TARGET=http://127.0.0.1:3001
FRONTEND_ALLOWED_HOSTS=

# For direct access, use a backend API base such as http://localhost:3001/api.
# For a Cloudeka demo through the Vite proxy, keep VITE_API_BASE_URL=/api
# and set BACKEND_PROXY_TARGET to the backend HTTPS origin without /api.
